{
  "name": "Coder (from plan)",
  "context": "coderepos",
  "description": "Fires the task description as a claude --remote prompt piped to FlightDesk. No local session \u2014 TaskOS runs the command directly.",
  "command": "cd \"$([ -d \"$HOME/workspaces/nestled-forms\" ] && printf %s \"$HOME/workspaces/nestled-forms\" || printf %s \"$HOME/IdeaProjects/nestled-forms\")\" && flightdesk register --project e7f6e567-caf6-4291-8b5d-6fcda9f60096 --title '{title}' --prompt '{description}'",
  "output_rules": [
    {
      "pattern": "Task ID: ([a-f0-9-]{36})",
      "action": "add_link",
      "url": "https://flightdesk.dev/app/tasks/{1}"
    }
  ],
  "project": "nestled-forms",
  "coding": true
}
