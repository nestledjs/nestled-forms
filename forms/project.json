{
  "name": "forms",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "forms/src",
  "projectType": "library",
  "publishable": true,
  "tags": [],
  "implicitDependencies": ["forms-core"],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/forms"],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../dist/forms"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "options": {
        "reporters": ["default", "verbose"],
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../coverage/forms"
      },
      "configurations": {
        "ci": {
          "watch": false,
          "coverage.enabled": true
        }
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "cwd": "forms",
        "command": "vitest run --reporter=default --reporter=verbose --passWithNoTests --project unit --coverage.reportsDirectory=../coverage/forms"
      },
      "configurations": {
        "ci": {
          "command": "vitest run --reporter=default --reporter=verbose --passWithNoTests --project unit --coverage.reportsDirectory=../coverage/forms --coverage.enabled"
        }
      }
    },
    "test:storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "forms",
        "command": "vitest run --reporter=default --reporter=verbose --passWithNoTests --project storybook"
      }
    }
  }
}
