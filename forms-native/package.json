{
  "name": "@nestledjs/forms-native",
  "version": "0.8.0",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./apollo": {
      "import": "./apollo.js",
      "types": "./apollo.d.ts"
    }
  },
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "description": "React Native form library powered by @nestledjs/forms-core — declarative, validated, themeable forms for Expo and React Native",
  "keywords": [
    "react-native",
    "expo",
    "forms",
    "typescript",
    "validation",
    "react-hook-form",
    "zod",
    "nativewind"
  ],
  "author": "Nestled Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestledjs/nestled.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@apollo/client": "^3.0.0 || ^4.0.0",
    "@hookform/resolvers": "^3.0.0",
    "@react-native-community/datetimepicker": ">=8.0.0",
    "expo-checkbox": ">=3.0.0",
    "react": ">=18.0.0",
    "react-hook-form": "^7.0.0",
    "react-native": ">=0.72.0",
    "react-native-element-dropdown": ">=2.0.0",
    "@ronradtke/react-native-markdown-display": ">=8.0.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": false
    },
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "expo-checkbox": {
      "optional": true
    },
    "react-native-element-dropdown": {
      "optional": true
    },
    "@ronradtke/react-native-markdown-display": {
      "optional": true
    },
    "zod": {
      "optional": false
    }
  },
  "dependencies": {
    "@nestledjs/forms-core": "0.8.0"
  }
}
